# ============================================================
# @yoooclaw/cli OSS 上传配置（tools/oss-upload 本地手动补传用）
# 复制为 .env 并填入实际值；CI 里 key/secret 走 GitHub Secrets
# ============================================================

OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=yoooclaw-artifacts
OSS_PUBLIC_URL=https://artifact.yoooclaw.com
OSS_PREFIX=cli

# 可选：endpoint 覆盖、对象 ACL、Cache-Control
# CI/本地未配置时使用区域端点；CI 支持 OSS_ENDPOINT secret 或仓库 variable（secret 优先）。
# 显式启用加速可设 https://oss-accelerate.aliyuncs.com（桶需开启传输加速）
OSS_ENDPOINT=
OSS_OBJECT_ACL=
OSS_CACHE_CONTROL=no-cache, no-store, max-age=0, must-revalidate

# 独立制品并发上传，范围 1–8；单文件分片并发保持 3。
OSS_UPLOAD_CONCURRENCY=4
