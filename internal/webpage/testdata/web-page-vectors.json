  "$rule": "规则不一致 = 同一网页在不同端落成两个文件，去重直接失效。改这里必须同步改全部副本（内容需逐字节一致）。",

  "normalizeUrl": [
    { "name": "drops fragment", "in": "https://example.com/a#section", "out": "https://example.com/a" },
    { "name": "drops utm and tracking params", "in": "https://example.com/a?utm_source=x&utm_medium=y&fbclid=1&gclid=2&mc_cid=3&mc_eid=4&ref_src=5&keep=1", "out": "https://example.com/a?keep=1" },
    { "name": "tracking param match is case-insensitive", "in": "https://example.com/a?UTM_Source=x&FBCLID=1&b=2", "out": "https://example.com/a?b=2" },
    { "name": "sorts query by name and keeps duplicate order", "in": "https://example.com/a?b=2&a=1&b=1", "out": "https://example.com/a?a=1&b=2&b=1" },
    { "name": "strips trailing slash", "in": "https://example.com/a/b/", "out": "https://example.com/a/b" },
    { "name": "keeps root slash", "in": "https://example.com/", "out": "https://example.com/" },
    { "name": "adds root slash when path is empty", "in": "https://example.com", "out": "https://example.com/" },
    { "name": "lowercases scheme and host but not path", "in": "HTTPS://Example.COM/Path/To", "out": "https://example.com/Path/To" },
    { "name": "drops default https port", "in": "https://example.com:443/a", "out": "https://example.com/a" },
    { "name": "drops default http port", "in": "http://example.com:80/a", "out": "http://example.com/a" },
    { "name": "keeps non-default port", "in": "https://example.com:8443/a", "out": "https://example.com:8443/a" },
    { "name": "does not upgrade http to https", "in": "http://example.com/a", "out": "http://example.com/a" },
    { "name": "keeps www prefix", "in": "https://www.example.com/a", "out": "https://www.example.com/a" },
    { "name": "keeps pagination params", "in": "https://example.com/a?page=1", "out": "https://example.com/a?page=1" },
    { "name": "valueless param serializes with a trailing equals", "in": "https://example.com/a?flag", "out": "https://example.com/a?flag=" },
    { "name": "space serializes as plus", "in": "https://example.com/a?q=hello%20world", "out": "https://example.com/a?q=hello+world" },
    { "name": "asterisk stays literal and tilde is escaped", "in": "https://example.com/a?q=a*b~c", "out": "https://example.com/a?q=a*b%7Ec" },
    { "name": "non-ascii percent-encodes as utf-8", "in": "https://example.com/a?q=%E4%B8%AD%E6%96%87", "out": "https://example.com/a?q=%E4%B8%AD%E6%96%87" },
    { "name": "query emptied by filtering drops the question mark", "in": "https://example.com/a?utm_source=x", "out": "https://example.com/a" }
  ],

  "$rejected": "接收端比扩展的 normalizePageUrl 更严：只接受 http/https，其余一律拒收（§11 的浏览器禁区本来也抓不到）。注意 \"https:///a\" 这类空 host 不在表内——WHATWG 会把它折成 https://a/ 而 Go/Python 判为无 host，但扩展先规范化过，接收端见不到这种形状。",
  "rejectedUrls": ["", "   ", "not a url", "ftp://example.com/a", "chrome://settings", "file:///etc/hosts"],

